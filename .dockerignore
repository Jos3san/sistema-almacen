# Files Docker must NOT send to the build (the build context is the repo root).
# Keeps images small, builds fast and secrets out of the builder.
# Patterns here only match at the root unless they start with **/ (unlike .gitignore).

# Version control and editors
.git
.gitignore
.gitattributes
**/.vscode
**/.idea

# Secrets: never sent to the builder, at any depth
**/.env
**/.env.*
**/*.pem
**/*.key
**/secrets

# Local Python environments and caches (the image builds its own)
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache

# Frontend build output and dependencies
**/node_modules
**/dist

# Documentation, tests and private data are not needed to run services
docs
**/tests
**/*.xlsx
**/*.csv
**/*.log
