# Copy this file to infra/.env and change the values. infra/.env is ignored by Git.
# Local development only. Use letters and digits in the passwords:
# they go inside URLs, where symbols like @ : / # would break them.
# They are applied only when the database volume is created (first start).

# PostgreSQL administrator: only creates the databases and roles.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin

# core_owner: owns core's tables; used only by migrations.
CORE_OWNER_PASSWORD=change-me-owner

# core_app: used by the core service; reads and writes rows only.
CORE_APP_PASSWORD=change-me-app
