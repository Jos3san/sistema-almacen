# Copy this file to infra/.env and change the values. infra/.env is ignored by Git.
# Local development only. Use letters and digits in the passwords:
# they go inside URLs, where symbols like @ : / # would break them.
# The database passwords are applied only when the volume is created (first start).

# PostgreSQL administrator: only creates the databases and roles.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin

# core_owner: owns core's tables; used only by migrations.
CORE_OWNER_PASSWORD=change-me-owner
# core_app: used by the core service; reads and writes rows only.
CORE_APP_PASSWORD=change-me-app

# auth_owner and auth_app: same idea, for auth_db.
AUTH_OWNER_PASSWORD=change-me-auth-owner
AUTH_APP_PASSWORD=change-me-auth-app

# First owner user (HU-05), used once by the auth-bootstrap command.
# Password: at least 12 characters. You can delete these lines afterwards.
BOOTSTRAP_ADMIN_EMAIL=duenio@example.com
BOOTSTRAP_ADMIN_NAME=Dueño
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
